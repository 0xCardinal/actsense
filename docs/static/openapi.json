  "components": {
    "schemas": {
      "AuditRequest": {
        "properties": {
          "repository": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Repository"
          },
          "action": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Action"
          },
          "github_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Github Token"
          },
          "use_clone": {
            "type": "boolean",
            "title": "Use Clone",
            "default": false
          }
        },
        "type": "object",
        "title": "AuditRequest"
      },
      "AuditYAMLRequest": {
        "properties": {
          "yaml_content": {
            "type": "string",
            "title": "Yaml Content"
          },
          "github_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Github Token"
          }
        },
        "type": "object",
        "required": [
          "yaml_content"
        ],
        "title": "AuditYAMLRequest"
      },
      "DismissRequest": {
        "properties": {
          "fingerprint": {
            "type": "string",
            "title": "Fingerprint"
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "fingerprint"
        ],
        "title": "DismissRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OrgScanRequest": {
        "properties": {
          "org": {
            "type": "string",
            "title": "Org"
          },
          "repositories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Repositories"
          },
          "github_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Github Token"
          },
          "use_clone": {
            "type": "boolean",
            "title": "Use Clone",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "org",
          "repositories"
        ],
        "title": "OrgScanRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}